
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --------------------------------------------------
    // Authentication helpers
    // --------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn()
        && request.auth.token.email_verified == true;
    }

    function aluStudent() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches(
          '.*@alustudent\\.com$'
        );
    }

    function staff() {
      return verified()
        && request.auth.token.staff == true;
    }

    function member() {
      return verified()
        && (
          aluStudent()
          || staff()
        );
    }

    // --------------------------------------------------
    // User profiles
    // --------------------------------------------------

    match /users/{uid} {

      allow create: if signedIn()
        && aluStudent()
        && request.auth.uid == uid

        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'createdAt'
        ])

        && request.resource.data.email
          == request.auth.token.email

        && request.resource.data.firstName is string
        && request.resource.data.lastName is string;

      allow read: if member()
        && (
          request.auth.uid == uid
          || staff()
        );

      allow update, delete: if false;
    }

    // --------------------------------------------------
    // Incident reports
    // --------------------------------------------------

    match /incidents/{id} {

      // Verified ALU members can read incident reports.
      allow read: if member();

      // Students can create incident reports.
      allow create: if member()
        && aluStudent()

        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reporterName',
          'title',
          'description',
          'category',
          'location',
          'photoUrl',
          'photoPath',
          'status',
          'createdAt',
          'updatedAt',
          'statusHistory'
        ])

        && request.resource.data.reporterId
          == request.auth.uid

        && request.resource.data.status
          == 'Submitted'

        && request.resource.data.statusHistory == []

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time

        && request.resource.data.title is string

        && request.resource.data.title.size() >= 5

        && request.resource.data.title.size() <= 80

        && request.resource.data.description is string

        && request.resource.data.description.size() >= 15

        && request.resource.data.description.size() <= 1500

        && request.resource.data.category in [
          'Facilities',
          'Water',
          'Electricity',
          'Sanitation',
          'Safety',
          'Other'
        ]

        && request.resource.data.location in [
          'Classrooms',
          'Library',
          'Cafeteria',
          'Student Residence',
          'Computer Lab',
          'Reception',
          'Outdoor Area',
          'Other'
        ];

      // ------------------------------------------------
      // Incident updates
      // ------------------------------------------------

      allow update: if member() && (

        // Students can edit their own submitted reports.
        (
          aluStudent()

          && resource.data.reporterId
            == request.auth.uid

          && resource.data.status
            == 'Submitted'

          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'title',
            'description',
            'category',
            'location',
            'updatedAt'
          ])

          && request.resource.data.title is string

          && request.resource.data.title.size() >= 5

          && request.resource.data.title.size() <= 80

          && request.resource.data.description is string

          && request.resource.data.description.size() >= 15

          && request.resource.data.description.size() <= 1500

          && request.resource.data.updatedAt
            == request.time
        )

        ||

        // Authorized staff can update incident statuses.
        (
          staff()

          && request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'status',
            'updatedAt',
            'statusHistory'
          ])

          && request.resource.data.status in [
            'Submitted',
            'In Progress',
            'Resolved'
          ]

          && request.resource.data.status
            != resource.data.status

          && request.resource.data.updatedAt
            == request.time

          && request.resource.data.statusHistory is list

          && request.resource.data.statusHistory.size()
            == resource.data.statusHistory.size() + 1

          && request.resource.data.statusHistory[
            request.resource.data.statusHistory.size() - 1
          ].by == request.auth.uid

          && request.resource.data.statusHistory[
            request.resource.data.statusHistory.size() - 1
          ].status == request.resource.data.status
        )
      );

      // Students may delete reports before staff
      // begin working on them.
      allow delete: if member()
        && aluStudent()
        && request.auth.uid
          == resource.data.reporterId
        && resource.data.status
          == 'Submitted';
    }
  }
}
